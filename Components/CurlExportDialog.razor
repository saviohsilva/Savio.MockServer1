<div class="app-dialog-content">
    <i class="bi bi-terminal fs-1 text-secondary d-block mb-3 app-dialog-icon text-center"></i>
    <p class="app-dialog-message text-center">Comando cURL equivalente a este mock:</p>

    <textarea class="form-control font-monospace mb-2" rows="6" readonly>@CurlText</textarea>

    @if (Warnings.Count > 0)
    {
        <div class="alert alert-warning py-2 small mb-2">
            @foreach (var warning in Warnings)
            {
                <div><i class="bi bi-info-circle"></i> @warning</div>
            }
        </div>
    }

    <div class="d-flex justify-content-center gap-2 app-dialog-actions">
        <button class="btn btn-secondary" @onclick="Close">Fechar</button>
        <button class="btn btn-primary" @onclick="Copy">
            <i class="bi bi-clipboard"></i> @(copied ? "Copiado!" : "Copiar")
        </button>
    </div>
</div>
