@page "/mock/create"
@page "/mock/edit/{Id}"
@using Savio.MockServer.Services
@using Savio.MockServer.Data.Repositories
@using Savio.MockServer.Data.Entities
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@inject MockService MockService
@inject IUnmockedRequestRepository UnmockedRepo
@inject IMockBinaryStorage BinaryStorage
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@(IsEdit ? "Editar Mock" : "Novo Mock")</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="bi @(IsEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>@(IsEdit ? "Editar Mock" : "Novo Mock")
            </h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-secondary" @onclick="Cancel">
                <i class="bi bi-arrow-left"></i> Voltar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(targetUserId))
    {
        <div class="alert alert-info py-2 mb-3">
            <i class="bi bi-shield-lock"></i> <strong>Modo administrador:</strong> este mock será criado para o usuário <strong>@targetUserName</strong>.
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Configurações Básicas</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Rota *</label>
                        <input type="text" class="form-control" @bind="mock.Route" placeholder="/api/exemplo" />
                        <small class="form-text text-muted">Ex: /api/usuarios ou /api/usuarios/{id}</small>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Método HTTP *</label>
                            <select class="form-select" @bind="mock.Method">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                                <option value="PATCH">PATCH</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Código HTTP *</label>
                            <input type="number" class="form-control" @bind="mock.StatusCode" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Delay (ms)</label>
                            <input type="number" class="form-control" @bind="mock.DelayMs" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <input type="text" class="form-control" @bind="mock.Description" placeholder="Descrição do endpoint" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Agrupamento</label>
                        <select class="form-select" @bind="mock.MockGroupId">
                            <option value="">Nenhum (isolado)</option>
                            @foreach (var group in groups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" @bind="mock.IsActive" id="activeSwitch">
                            <label class="form-check-label" for="activeSwitch">
                                Endpoint ativo
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(saveError))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @saveError
                        </div>
                    }
                </div>
            </div>

            <!-- Autenticação -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>Autenticação</h5>
                </div>
                <div class="card-body">
                    <!-- Mode selector -->
                    <div class="btn-group w-100 mb-2" role="group">
                        <input type="radio" class="btn-check" name="authMode" id="authNone"
                               checked="@(_authMode == "")" @onchange='() => OnAuthModeChanged("")' />
                        <label class="btn btn-outline-secondary" for="authNone">
                            <i class="bi bi-slash-circle me-1"></i>Nenhuma
                        </label>
                        <input type="radio" class="btn-check" name="authMode" id="authIssuer"
                               checked="@(_authMode == "issuer")" @onchange='() => OnAuthModeChanged("issuer")' />
                        <label class="btn btn-outline-primary" for="authIssuer">
                            <i class="bi bi-key me-1"></i>Emite tokens
                        </label>
                        <input type="radio" class="btn-check" name="authMode" id="authProtected"
                               checked="@(_authMode == "protected")" @onchange='() => OnAuthModeChanged("protected")' />
                        <label class="btn btn-outline-warning" for="authProtected">
                            <i class="bi bi-shield-check me-1"></i>Protegido
                        </label>
                    </div>
                    <small class="form-text text-muted d-block mb-3">
                        @if (_authMode == "issuer")
                        {
                            <span>Este endpoint valida credenciais e retorna tokens. Configure como os tokens serão gerados abaixo.</span>
                        }
                        else if (_authMode == "protected")
                        {
                            <span>Este endpoint exige um token válido emitido por outro endpoint configurado.</span>
                        }
                        else
                        {
                            <span>Sem autenticação — qualquer requisição é aceita.</span>
                        }
                    </small>

                    @* ── EMITE TOKENS ── *@
                    @if (_authMode == "issuer")
                    {
                        <div class="mb-3">
                            <label class="form-label">Tipo de autenticação</label>
                            <select class="form-select" @bind="inlineAuthConfig.Type" @bind:after="OnInlineTypeChanged">
                                <option value="@MockAuthType.Basic">Basic (usuário + senha)</option>
                                <option value="@MockAuthType.Bearer">Bearer / JWT</option>
                                <option value="@MockAuthType.CustomToken">Token customizado</option>
                                <option value="@MockAuthType.ApiKey">API Key</option>
                            </select>
                        </div>

                        @if (inlineAuthConfig.Type == MockAuthType.Basic || inlineAuthConfig.Type == MockAuthType.Bearer)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Usuário</label>
                                    <input type="text" class="form-control" @bind="inlineAuthConfig.Username"
                                           placeholder="admin" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Senha</label>
                                    <input type="password" class="form-control" @bind="inlineAuthConfig.Password"
                                           placeholder="senha123" />
                                </div>
                            </div>
                        }

                        @if (inlineAuthConfig.Type == MockAuthType.CustomToken)
                        {
                            <div class="card mb-3 border-primary border-opacity-25">
                                <div class="card-header d-flex justify-content-between align-items-center py-2 bg-primary bg-opacity-10">
                                    <span class="small fw-semibold"><i class="bi bi-sliders me-1"></i>Parâmetros de validação</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddInlineValidationParam">
                                        <i class="bi bi-plus"></i> Adicionar
                                    </button>
                                </div>
                                <div class="card-body py-3">
                                    @if (!inlineAuthConfig.CustomValidationParams.Any())
                                    {
                                        <p class="text-muted mb-0">Nenhum parâmetro de validação configurado.</p>
                                    }
                                    else
                                    {
                                        @foreach (var param in inlineAuthConfig.CustomValidationParams)
                                        {
                                            <div class="row g-2 align-items-center mb-2">
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control" @bind="param.Name" placeholder="Nome" />
                                                </div>
                                                <div class="col-md-3">
                                                    <select class="form-select" @bind="param.Location">
                                                        <option value="@AuthParamLocation.Body">Body</option>
                                                        <option value="@AuthParamLocation.QueryString">QueryString</option>
                                                        <option value="@AuthParamLocation.Header">Header</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <input type="text" class="form-control" @bind="param.Value" placeholder="Valor esperado" />
                                                </div>
                                                <div class="col-md-1 d-grid">
                                                    <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveInlineValidationParam(param)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        @if (inlineAuthConfig.Type == MockAuthType.Bearer || inlineAuthConfig.Type == MockAuthType.CustomToken)
                        {
                            <div class="card mb-3 border-primary border-opacity-25">
                                <div class="card-header d-flex align-items-center justify-content-between py-2 bg-primary bg-opacity-10">
                                    <span class="small fw-semibold"><i class="bi bi-shield-lock me-1"></i>Token JWT</span>
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox"
                                               @bind="inlineAuthConfig.GenerateJwtToken" id="jwtSwitch" />
                                        <label class="form-check-label small" for="jwtSwitch">Gerar token real</label>
                                    </div>
                                </div>
                                @if (inlineAuthConfig.GenerateJwtToken)
                                {
                                    <div class="card-body py-3">
                                        <div class="alert alert-info py-2 small mb-3">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Quando ativado, este endpoint retorna um JWT assinado real. Endpoints no modo
                                            <em>Protegido</em> que usem esta configuração validarão o token automaticamente.
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Secret Key</label>
                                            <input type="text" class="form-control font-monospace"
                                                   @bind="inlineAuthConfig.JwtSecretKey"
                                                   placeholder="Deixe vazio para secret auto-gerada (mínimo 32 chars recomendado)" />
                                        </div>
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-4">
                                                <label class="form-label">Expiração (min)</label>
                                                <input type="number" class="form-control"
                                                       @bind="inlineAuthConfig.JwtExpirationMinutes" min="1" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Issuer</label>
                                                <input type="text" class="form-control"
                                                       @bind="inlineAuthConfig.JwtIssuer" placeholder="Savio.MockServer" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Audience</label>
                                                <input type="text" class="form-control"
                                                       @bind="inlineAuthConfig.JwtAudience" placeholder="Opcional" />
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label">Claims adicionais (JSON)</label>
                                            <textarea class="form-control font-monospace" rows="2"
                                                      @bind="inlineAuthConfig.JwtAdditionalClaimsJson"
                                                      placeholder='{"role":"admin","tenant":"empresa"}'></textarea>
                                            <small class="form-text text-muted">Claims extras incluídas no payload do token.</small>
                                        </div>

                                        @if (inlineAuthConfig.Type == MockAuthType.CustomToken)
                                        {
                                            <hr />
                                            <h6 class="mb-3">Retorno do token</h6>
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">Local</label>
                                                    <select class="form-select" @bind="inlineAuthConfig.CustomTokenReturnLocation">
                                                        <option value="@TokenReturnLocation.Body">Body</option>
                                                        <option value="@TokenReturnLocation.Header">Header</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Nome</label>
                                                    <input type="text" class="form-control" @bind="inlineAuthConfig.CustomTokenReturnName" placeholder="token" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Prefixo</label>
                                                    <input type="text" class="form-control" @bind="inlineAuthConfig.CustomTokenPrefix" placeholder="pre_" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Sufixo</label>
                                                    <input type="text" class="form-control" @bind="inlineAuthConfig.CustomTokenSuffix" placeholder="_suf" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (inlineAuthConfig.Type == MockAuthType.ApiKey)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-5">
                                    <label class="form-label">Header *</label>
                                    <input type="text" class="form-control" @bind="inlineAuthConfig.ApiKeyHeader"
                                           placeholder="X-API-Key" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label">Valor esperado *</label>
                                    <input type="text" class="form-control font-monospace"
                                           @bind="inlineAuthConfig.ApiKeyValue" placeholder="minha-chave-secreta" />
                                </div>
                            </div>
                        }
                    }

                    @* ── PROTEGIDO ── *@
                    @if (_authMode == "protected")
                    {
                        <div class="mb-3">
                            <label class="form-label">Validado por</label>
                            <select class="form-select" @bind="mock.AuthConfigId">
                                <option value="">Selecione o endpoint de autenticação...</option>
                                @foreach (var cfg in authConfigs)
                                {
                                    <option value="@cfg.Id">@cfg.Name</option>
                                }
                            </select>
                            @if (!authConfigs.Any())
                            {
                                <div class="alert alert-warning py-2 small mt-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Nenhum endpoint de autenticação configurado ainda. Crie um endpoint no modo
                                    <em>Emite tokens</em> primeiro.
                                </div>
                            }
                            else
                            {
                                <small class="form-text text-muted">
                                    Requisições sem token válido deste emissor receberão <code>401 Unauthorized</code>.
                                </small>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Certificado de Cliente (mTLS) -->
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-lock2 me-2"></i>Certificado de Cliente</h5>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" @bind="mock.RequireClientCertificate" id="endpointCertSwitch" />
                        <label class="form-check-label small" for="endpointCertSwitch">Exigir mTLS</label>
                    </div>
                </div>
                @if (mock.RequireClientCertificate)
                {
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Certificado esperado</label>
                            <select class="form-select" @bind="mock.RequiredClientCertificateId">
                                <option value="">Qualquer certificado válido</option>
                                @foreach (var cert in certificates)
                                {
                                    <option value="@cert.Id">@cert.Name — @cert.Thumbprint[..16]…</option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                Se selecionado, apenas o certificado com este thumbprint será aceito.
                                <a href="/certificados/novo" target="_blank" class="ms-1">Gerar novo certificado</a>
                            </small>
                        </div>
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Para validar certificados mTLS, o Kestrel precisa estar configurado com
                            <code>ClientCertificateMode.AllowCertificate</code> no <code>appsettings.json</code>.
                        </div>
                    </div>
                }
                @if (!mock.RequireClientCertificate)
                {
                    <div class="card-body py-2">
                        <small class="text-muted">Sem exigência de certificado — qualquer cliente pode acessar este endpoint.</small>
                    </div>
                }
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Headers Customizados</h5>
                </div>
                <div class="card-body">
                    @foreach (var header in headersInput)
                    {
                        <div class="row mb-2">
                            <div class="col-5">
                                <input type="text" class="form-control" placeholder="Nome do header" @bind="header.Key" />
                            </div>
                            <div class="col-5">
                                <input type="text" class="form-control" placeholder="Valor" @bind="header.Value" />
                            </div>
                            <div class="col-2">
                                <button class="btn btn-danger w-100" @onclick="() => RemoveHeader(header)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddHeader">
                        <i class="bi bi-plus"></i> Adicionar Header
                    </button>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Response Body</h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="responseType" id="jsonRadio" @onchange="() => SetResponseType(true)" checked="@useJson">
                            <label class="btn btn-outline-primary" for="jsonRadio">JSON</label>

                            <input type="radio" class="btn-check" name="responseType" id="rawRadio" @onchange="() => SetResponseType(false)" checked="@(!useJson && !useBinary && !useMultipart)">
                            <label class="btn btn-outline-primary" for="rawRadio">Raw/Primitivo</label>

                            <input type="radio" class="btn-check" name="responseType" id="binRadio" @onchange="() => SetResponseBinary()" checked="@useBinary">
                            <label class="btn btn-outline-primary" for="binRadio">Binário (Arquivo)</label>

                            <input type="radio" class="btn-check" name="responseType" id="multiRadio" @onchange="() => SetResponseMultipart()" checked="@useMultipart">
                            <label class="btn btn-outline-primary" for="multiRadio">Multipart (JSON)</label>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (useMultipart)
                    {
                        <div class="mb-2">
                            <label class="form-label">JSON/Config do multipart</label>
                            <textarea class="form-control font-monospace" rows="8" @bind="mock.ResponseMultipartJson" placeholder='{"subtype":"mixed","parts":[{"headers":{"Content-Disposition":"form-data; name=\"meta\""},"text":"ok"},{"fileName":"file.bin","contentType":"application/octet-stream","blobId":123}]}'></textarea>
                            <small class="form-text text-muted">Você pode editar o JSON. Para arquivos, use o upload abaixo (gera BlobId automaticamente).</small>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Adicionar arquivo como part</label>
                            <InputFile OnChange="OnMultipartFileSelected" />
                            @if (!string.IsNullOrEmpty(uploadedMultipartError))
                            {
                                <div class="text-danger small">
                                    <i class="bi bi-exclamation-circle"></i> @uploadedMultipartError
                                </div>
                            }
                        </div>
                    }
                    else if (useBinary)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Content-Type</label>
                                <input class="form-control" placeholder="application/pdf" @bind="mock.ResponseBodyContentType" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">File name</label>
                                <input class="form-control" placeholder="arquivo.pdf" @bind="mock.ResponseBodyFileName" />
                            </div>
                        </div>

                        <InputFile OnChange="OnBinaryFileSelected" accept="*/*" />
                        @if (!string.IsNullOrEmpty(uploadedBinaryError))
                        {
                            <div class="text-danger small">
                                <i class="bi bi-exclamation-circle"></i> @uploadedBinaryError
                            </div>
                        }
                        <small class="form-text text-muted">Faça upload do arquivo. O servidor responderá os bytes reais. Se quiser forçar download, informe File name.</small>
                    }
                    else if (useJson)
                    {
                        <textarea class="form-control font-monospace" rows="10" @bind="mock.ResponseBodyJson" placeholder='{"mensagem": "Hello World"}'></textarea>
                        <small class="form-text text-muted">Cole seu JSON aqui (será validado ao salvar)</small>
                    }
                    else
                    {
                        <textarea class="form-control font-monospace" rows="10" @bind="mock.ResponseBodyRaw" placeholder="12345 ou texto simples"></textarea>
                        <small class="form-text text-muted">Para números primitivos (long, int) ou texto simples</small>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
                <button class="btn btn-primary" @onclick="Save">
                    <i class="bi bi-save"></i> Salvar Mock
                </button>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h6 class="mb-0">💡 Dicas</h6>
                </div>
                <div class="card-body">
                    <h6>Rotas com Parâmetros</h6>
                    <p class="small">Use <code>{'{nomeParametro}'}</code> para parâmetros dinâmicos:</p>
                    <code class="small">/api/usuarios/{'{id}'}</code>

                    <hr />

                    <h6 class="mt-3">Response Types</h6>
                    <ul class="small">
                        <li><strong>JSON:</strong> Para objetos e arrays</li>
                        <li><strong>Raw/Primitivo:</strong> Para números (<code>12345</code>) ou texto simples</li>
                        <li><strong>Binário:</strong> Para arquivos (PDF/Imagem/etc) via Base64</li>
                        <li><strong>Multipart (JSON):</strong> Para respostas mais complexas com múltiplas partes</li>
                    </ul>

                    <hr />

                    <h6 class="mt-3">Headers Comuns</h6>
                    <ul class="small">
                        <li><code>Content-Type: application/json</code></li>
                        <li><code>Content-Type: text/plain</code></li>
                        <li><code>Content-Type: application/pdf</code></li>
                    </ul>

                    <hr />

                    <h6 class="mt-3">Códigos HTTP</h6>
                    <ul class="small">
                        <li><strong>200:</strong> OK</li>
                        <li><strong>201:</strong> Created</li>
                        <li><strong>400:</strong> Bad Request</li>
                        <li><strong>404:</strong> Not Found</li>
                        <li><strong>500:</strong> Internal Server Error</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

