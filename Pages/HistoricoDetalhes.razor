@page "/historico/{Id:int}"
@using Savio.MockServer.Data.Repositories
@using Savio.MockServer.Services
@inject IRequestHistoryRepository HistoryRepo
@inject IMockBinaryStorage BinaryStorage
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Detalhes da Requisição</PageTitle>

<div class="container-fluid py-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>
    }
    else if (history == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Registro não encontrado.
        </div>
        <button class="btn btn-secondary" @onclick="VoltarParaLista">
            <i class="bi bi-arrow-left"></i> Voltar
        </button>
    }
    else
    {
        <div class="row mb-4">
            <div class="col">
                <h2 class="mb-1">📋 Detalhes da Requisição</h2>
                <p class="mb-0">
                    <span class="badge bg-@UiHelpers.GetMethodColor(history.Method)">@history.Method</span>
                    <code>@history.Route</code>
                </p>
            </div>
            <div class="col-auto d-flex gap-2 align-items-start">
                <button class="btn btn-sm btn-outline-primary" @onclick="CopyRequestPayload">
                    <i class="bi bi-copy"></i> Copiar Requisição
                </button>
                @if (history.MockEndpoint != null)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="EditarMock">
                        <i class="bi bi-pencil"></i> Editar Mock
                    </button>
                }
                <button class="btn btn-sm btn-outline-danger" @onclick="Excluir">
                    <i class="bi bi-trash"></i> Excluir
                </button>
                <button class="btn btn-sm btn-secondary" @onclick="VoltarParaLista">
                    <i class="bi bi-arrow-left"></i> Voltar
                </button>
            </div>
        </div>

        <div class="row">
            <!-- Informações Gerais -->
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">ℹ️ Informações Gerais</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="CopyGeneralInfo">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th class="col-th-180">Data/Hora:</th>
                                    <td>@TimezoneService.FormatLocalTime(history.RequestedAt, "dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <th>Status Code:</th>
                                    <td><span class="badge bg-@UiHelpers.GetStatusColor(history.ResponseStatusCode)">@history.ResponseStatusCode</span></td>
                                </tr>
                                <tr>
                                    <th>Delay:</th>
                                    <td>@history.DelayMs ms</td>
                                </tr>
                                <tr>
                                    <th>IP do Cliente:</th>
                                    <td><code>@history.ClientIp</code></td>
                                </tr>
                                @if (history.MockEndpoint != null)
                                {
                                    <tr>
                                        <th>Mock:</th>
                                        <td>@history.MockEndpoint.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Coluna Esquerda: Request -->
            <div class="col-lg-6">

                <!-- Request Headers -->
                <div class="mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">📤 Request Headers</h5>
                            <button class="btn btn-sm btn-outline-primary" @onclick="CopyRequestHeaders">
                                <i class="bi bi-clipboard"></i> Copiar
                            </button>
                        </div>
                        <div class="card-body">
                            @if (requestHeaders != null && requestHeaders.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0 table-fixed table-resizable">
                                    <thead>
                                        <tr>
                                            <th class="col-th-40pct">Header</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var header in requestHeaders.OrderBy(h => h.Key))
                                        {
                                            <tr>
                                                <td class="text-truncate td-clamp"><strong>@header.Key</strong></td>
                                                <td class="text-break td-break-all"><code class="small">@header.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Nenhum header</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Query Params -->
                @if (queryParams != null && queryParams.Any())
                {
                    <div class="mb-4">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">🔎 Query Params</h5>
                                <button class="btn btn-sm btn-outline-primary" @onclick="CopyQueryParams">
                                    <i class="bi bi-clipboard"></i> Copiar
                                </button>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th class="col-th-220">Parâmetro</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var param in queryParams)
                                        {
                                            <tr>
                                                <td><strong>@param.Key</strong></td>
                                                <td><code class="small">@param.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                <!-- Request Body -->
                <div class="mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">📥 Request Body</h5>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm @(requestBodyWrap ? "btn-outline-secondary" : "btn-secondary")"
                                        title="@(requestBodyWrap ? "Modo linear (barra horizontal)" : "Modo com quebra de linha")"
                                        @onclick="() => requestBodyWrap = !requestBodyWrap">
                                    <i class="bi @(requestBodyWrap ? "bi-text-wrap" : "bi-text-paragraph")"></i>
                                    @(requestBodyWrap ? "Linear" : "Quebrar")
                                </button>
                                @if (CanCopyRequestBody())
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="CopyRequestBody">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(history.RequestBodyBase64))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadRequestBase64">
                                        <i class="bi bi-download"></i> Baixar
                                    </button>
                                }
                                @if (HasMultipartRequestFiles)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-dark" @onclick="DownloadAllMultipartRequestFiles">
                                        <i class="bi bi-download"></i> Baixar Todos Arquivos
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(history.RequestFormJson))
                            {
                                <h6 class="text-muted">Form/MultiPart (normalizado)</h6>
                                <pre class="bg-light p-3 rounded @(requestBodyWrap ? "pre-scroll-400" : "pre-scroll-400-linear")"><code>@UiHelpers.FormatJson(history.RequestFormJson)</code></pre>

                                @if (HasMultipartRequestFiles)
                                {
                                    <h6 class="mt-3">Arquivos do Multipart</h6>
                                    @for (var i = 0; i < requestMultipartFiles.Count; i++)
                                    {
                                        var file = requestMultipartFiles[i];
                                        var fileIndex = i;
                                        <div class="border rounded p-3 mb-3">
                                            <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center mb-2">
                                                <div>
                                                    <div><strong>Campo:</strong> @file.FieldName</div>
                                                    <div><strong>Arquivo:</strong> @file.FileName</div>
                                                    <div><strong>ContentType:</strong> <code>@file.ContentType</code></div>
                                                    <div><strong>Tamanho:</strong> @FormatFileSize(file.Bytes.LongLength)</div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => DownloadMultipartRequestFile(fileIndex)">
                                                        <i class="bi bi-download"></i> Baixar
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadMultipartRequestFileAsBase64(fileIndex)">
                                                        <i class="bi bi-filetype-txt"></i> Baixar Base64
                                                    </button>
                                                </div>
                                            </div>

                                            @if (file.Preview.CanPreview && !string.IsNullOrWhiteSpace(file.Preview.DataUrl))
                                            {
                                                <h6 class="mt-3">Pré-visualização segura:</h6>
                                                @if (file.Preview.IsPdf)
                                                {
                                                    <iframe src="@file.Preview.DataUrl" class="w-100 border rounded bg-white" style="height: 520px;" title="Preview PDF"></iframe>
                                                }
                                                else
                                                {
                                                    <img src="@file.Preview.DataUrl" class="img-fluid border rounded bg-white p-2" alt="Preview da imagem" />
                                                }
                                            }
                                            else
                                            {
                                                <div class="alert alert-warning mb-0 mt-2">
                                                    <i class="bi bi-shield-exclamation"></i>
                                                    Pré-visualização bloqueada. @file.Preview.BlockReason
                                                    <br />
                                                    Este tipo de arquivo pode apenas ser baixado.
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                            else if (!string.IsNullOrEmpty(history.RequestBody))
                            {
                                <pre class="bg-light p-3 rounded @(requestBodyWrap ? "pre-scroll-400" : "pre-scroll-400-linear")"><code>@UiHelpers.FormatJson(history.RequestBody)</code></pre>
                            }
                            else if (!string.IsNullOrEmpty(history.RequestBodyBase64))
                            {
                                <p class="text-muted">Request binário capturado (Base64) - ContentType: <code>@history.RequestBodyContentType</code></p>
                                @if (requestBase64Preview != null)
                                {
                                    <div class="mb-2">
                                        <strong>Tamanho:</strong> @FormatFileSize(requestBase64Preview.SizeBytes)
                                    </div>

                                    @if (requestBase64Preview.CanPreview && !string.IsNullOrWhiteSpace(requestBase64Preview.DataUrl))
                                    {
                                        <h6 class="mt-3">Pré-visualização segura:</h6>
                                        @if (requestBase64Preview.IsPdf)
                                        {
                                            <iframe src="@requestBase64Preview.DataUrl" class="w-100 border rounded bg-white" style="height: 520px;" title="Preview PDF"></iframe>
                                        }
                                        else
                                        {
                                            <img src="@requestBase64Preview.DataUrl" class="img-fluid border rounded bg-white p-2" alt="Preview da imagem" />
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="bi bi-shield-exclamation"></i>
                                            Pré-visualização bloqueada. @requestBase64Preview.BlockReason
                                            <br />
                                            Este tipo de arquivo pode apenas ser baixado.
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Nao foi possivel interpretar o conteudo binario para pré-visualização.
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Vazio</p>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- Coluna Direita: Response -->
            <div class="col-lg-6">

                <!-- Response Headers -->
                <div class="mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">📥 Response Headers</h5>
                            <button class="btn btn-sm btn-outline-primary" @onclick="CopyResponseHeaders">
                                <i class="bi bi-clipboard"></i> Copiar
                            </button>
                        </div>
                        <div class="card-body">
                            @if (responseHeaders != null && responseHeaders.Any())
                            {
                                <div class="table-responsive">
                                <table class="table table-sm table-hover table-fixed">
                                    <thead>
                                        <tr>
                                            <th class="col-th-40pct">Header</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var header in responseHeaders.OrderBy(h => h.Key))
                                        {
                                            <tr>
                                                <td class="text-truncate td-clamp"><strong>@header.Key</strong></td>
                                                <td class="text-break td-break-all"><code class="small">@header.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Nenhum header</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Response Body -->
                <div class="mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">📤 Response Body</h5>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm @(responseBodyWrap ? "btn-outline-secondary" : "btn-secondary")"
                                        title="@(responseBodyWrap ? "Modo linear (barra horizontal)" : "Modo com quebra de linha")"
                                        @onclick="() => responseBodyWrap = !responseBodyWrap">
                                    <i class="bi @(responseBodyWrap ? "bi-text-wrap" : "bi-text-paragraph")"></i>
                                    @(responseBodyWrap ? "Linear" : "Quebrar")
                                </button>
                                @if (CanCopyResponseBody())
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="CopyResponseBody">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                }
                                @if (history.ResponseBinaryBlobId.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadResponseBlob">
                                        <i class="bi bi-download"></i> Baixar Response Grande
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(history.ResponseBodyBase64))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadResponseBase64">
                                        <i class="bi bi-download"></i> Baixar
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (history.ResponseBinaryBlobId.HasValue)
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> Response body muito grande (armazenado como blob #@history.ResponseBinaryBlobId).
                                    <br />
                                    <strong>ContentType:</strong> <code>@(history.ResponseBodyContentType ?? "application/octet-stream")</code>
                                    @if (responseBlobContent != null)
                                    {
                                        <hr />
                                        <div>
                                            <strong>Tamanho:</strong> @FormatFileSize(responseBlobContent.Length)
                                        </div>
                                        @if (responseBlobPreview?.CanPreview == true && !string.IsNullOrWhiteSpace(responseBlobPreview.DataUrl))
                                        {
                                            <h6 class="mt-3">Pré-visualização segura:</h6>
                                            @if (responseBlobPreview.IsPdf)
                                            {
                                                <iframe src="@responseBlobPreview.DataUrl" class="w-100 border rounded bg-white" style="height: 520px;" title="Preview PDF"></iframe>
                                            }
                                            else
                                            {
                                                <img src="@responseBlobPreview.DataUrl" class="img-fluid border rounded bg-white p-2" alt="Preview da imagem" />
                                            }
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mt-3 mb-0">
                                                <i class="bi bi-shield-exclamation"></i>
                                                Pré-visualização bloqueada. @responseBlobPreview?.BlockReason
                                                <br />
                                                Este tipo de arquivo pode apenas ser baixado.
                                            </div>
                                        }
                                    }
                                    else if (loadingBlobContent)
                                    {
                                        <div class="spinner-border spinner-border-sm mt-2" role="status">
                                            <span class="visually-hidden">Carregando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="LoadResponseBlobContent">
                                            <i class="bi bi-eye"></i> Carregar Preview
                                        </button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(history.ResponseBodyBase64))
                            {
                                <p class="text-muted">Response binário - ContentType: <code>@history.ResponseBodyContentType</code></p>
                                @if (responseBase64Preview != null)
                                {
                                    <div class="mb-2">
                                        <strong>Tamanho:</strong> @FormatFileSize(responseBase64Preview.SizeBytes)
                                    </div>

                                    @if (responseBase64Preview.CanPreview && !string.IsNullOrWhiteSpace(responseBase64Preview.DataUrl))
                                    {
                                        <h6 class="mt-3">Pré-visualização segura:</h6>
                                        @if (responseBase64Preview.IsPdf)
                                        {
                                            <iframe src="@responseBase64Preview.DataUrl" class="w-100 border rounded bg-white" style="height: 520px;" title="Preview PDF"></iframe>
                                        }
                                        else
                                        {
                                            <img src="@responseBase64Preview.DataUrl" class="img-fluid border rounded bg-white p-2" alt="Preview da imagem" />
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="bi bi-shield-exclamation"></i>
                                            Pré-visualização bloqueada. @responseBase64Preview.BlockReason
                                            <br />
                                            Este tipo de arquivo pode apenas ser baixado.
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Nao foi possivel interpretar o conteudo binario para pré-visualização.
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(history.ResponseBody))
                            {
                                <pre class="bg-light p-3 rounded @(responseBodyWrap ? "pre-scroll-500-wrap" : "pre-scroll-500-linear")"><code>@UiHelpers.FormatJson(history.ResponseBody)</code></pre>
                            }
                            else
                            {
                                <p class="text-muted">Vazio</p>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

