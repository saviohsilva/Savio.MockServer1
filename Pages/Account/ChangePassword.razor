@page "/account/change-password"
@layout Savio.MockServer.Shared.AuthLayout

<PageTitle>Alterar Senha - Savio Mock Server</PageTitle>

<div class="card shadow auth-card-wide">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <img src="img/logo.svg" alt="Mock Server" width="48" height="48" />
            <h4 class="mt-2">Alterar Senha</h4>
            <p class="text-muted small">Informe sua senha atual e a nova senha</p>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(statusMessageClass)">
                @statusMessage
            </div>
        }

        <EditForm Model="credentialUpdateModel" OnValidSubmit="HandleCredentialUpdate">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Senha atual</label>
                <InputText type="password" class="form-control" @bind-Value="credentialUpdateModel.CurrentSecret" placeholder="Informe sua senha atual" />
                <ValidationMessage For="() => credentialUpdateModel.CurrentSecret" />
            </div>

            <div class="mb-3">
                <label class="form-label">Nova senha</label>
                <InputText type="password" class="form-control" @bind-Value="credentialUpdateModel.NewSecret" placeholder="Mínimo 6 caracteres" />
                <ValidationMessage For="() => credentialUpdateModel.NewSecret" />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirmar nova senha</label>
                <InputText type="password" class="form-control" @bind-Value="credentialUpdateModel.ConfirmNewSecret" placeholder="Repita a nova senha" />
                <ValidationMessage For="() => credentialUpdateModel.ConfirmNewSecret" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-shield-lock"></i> Alterar Senha
                </button>
                <a href="/account/settings" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </EditForm>
    </div>
</div>
