@page "/account/reset-password"
@layout Savio.MockServer.Shared.AuthLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Redefinir Senha - Savio Mock Server</PageTitle>

<div class="card shadow auth-card-wide">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <img src="img/logo.svg" alt="Mock Server" width="48" height="48" />
            <h4 class="mt-2">Redefinir Senha</h4>
            <p class="text-muted small">Defina sua nova senha de acesso</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i> @errorMessage
            </div>
        }

        @if (passwordReset)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i> Sua senha foi redefinida com sucesso.
            </div>
            <div class="text-center">
                <a href="/account/login?reset=success" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Ir para Login
                </a>
            </div>
        }
        else if (invalidLink)
        {
            <div class="alert alert-danger">
                <i class="bi bi-x-circle"></i> Link de redefinição inválido ou expirado.
            </div>
            <div class="text-center">
                <a href="/account/forgot-password" class="btn btn-secondary">
                    <i class="bi bi-arrow-repeat"></i> Solicitar novo link
                </a>
            </div>
        }
        else
        {
            <EditForm Model="resetPasswordModel" OnValidSubmit="HandleResetPassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <InputText type="email" class="form-control" @bind-Value="resetPasswordModel.Email" readonly />
                    <ValidationMessage For="() => resetPasswordModel.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nova senha</label>
                    <InputText type="password" class="form-control" @bind-Value="resetPasswordModel.NewPassword" placeholder="Mínimo 6 caracteres" />
                    <ValidationMessage For="() => resetPasswordModel.NewPassword" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nova senha</label>
                    <InputText type="password" class="form-control" @bind-Value="resetPasswordModel.ConfirmPassword" placeholder="Repita a nova senha" />
                    <ValidationMessage For="() => resetPasswordModel.ConfirmPassword" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-shield-lock"></i> Redefinir Senha
                </button>
            </EditForm>
        }
    </div>
</div>
