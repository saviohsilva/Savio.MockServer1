@page "/account/forgot-password"
@layout Savio.MockServer.Shared.AuthLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Recuperar Senha - Savio Mock Server</PageTitle>

<div class="card shadow auth-card">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <img src="img/logo.svg" alt="Mock Server" width="48" height="48" />
            <h4 class="mt-2">Recuperar Senha</h4>
            <p class="text-muted small">Informe seu e-mail para receber o link de redefinição</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i> @errorMessage
            </div>
        }

        @if (emailSent)
        {
            <div class="alert alert-success">
                <i class="bi bi-envelope-check"></i> Se o e-mail estiver cadastrado e confirmado, você receberá um link para redefinir sua senha.
            </div>

            <div class="text-center mt-3">
                <a href="/account/login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Voltar ao Login
                </a>
            </div>
        }
        else
        {
            <EditForm Model="forgotPasswordModel" OnValidSubmit="HandleForgotPassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <InputText type="email" class="form-control" @bind-Value="forgotPasswordModel.Email" placeholder="seu@email.com" />
                    <ValidationMessage For="() => forgotPasswordModel.Email" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-envelope"></i> Enviar Link de Redefinição
                </button>
            </EditForm>

            <hr />

            <div class="text-center">
                <a href="/account/login" class="text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Voltar para login
                </a>
            </div>
        }
    </div>
</div>
