@page "/group/create"
@page "/group/edit/{Id:int}"
@using Savio.MockServer.Services
@using Savio.MockServer.Models
@using Microsoft.AspNetCore.Identity
@using Savio.MockServer.Data.Entities
@inject MockService MockService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@(IsEdit ? "Editar Grupo" : "Novo Grupo")</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1>@(IsEdit ? "Editar Grupo" : "Novo Grupo")</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-secondary" @onclick="Cancel">
                <i class="bi bi-arrow-left"></i> Voltar
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Dados do Grupo -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Dados do Grupo</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Nome do Grupo *</label>
                        <input type="text" class="form-control" @bind="groupName" placeholder="Ex: Mock Teste Token GOV 01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <input type="text" class="form-control" @bind="groupDescription" placeholder="Descrição do agrupamento" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cor do Grupo</label>
                        <div class="d-flex align-items-center gap-3">
                            <input type="color" class="form-control form-control-color" style="width:60px;height:38px;" @bind="groupColor" />
                            <span class="badge badge-wrap fs-6 px-3 py-2" style="background-color:@groupColor">
                                <i class="bi bi-folder"></i> @(string.IsNullOrWhiteSpace(groupName) ? "Pré-visualização" : groupName)
                            </span>
                        </div>
                        <div class="form-text">Escolha uma cor para identificar visualmente este grupo nas listagens.</div>
                    </div>

                    @if (!string.IsNullOrEmpty(saveError))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @saveError
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
                        <button class="btn btn-primary" @onclick="SaveGroup">
                            <i class="bi bi-save"></i> Salvar Grupo
                        </button>
                    </div>
                </div>
            </div>

            @if (IsEdit)
            {
                <!-- Mocks do Grupo (edição) -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Mocks do Grupo (@groupMocks.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Filtrar por rota..." @bind="groupMocksFilter" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(groupMocksFilter))
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => groupMocksFilter = string.Empty" title="Limpar filtro">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        @if (!groupMocks.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-info-circle"></i> Nenhum mock neste grupo. Adicione mocks isolados abaixo.
                            </div>
                        }
                        else if (!FilteredGroupMocks.Any())
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-filter"></i> Nenhum mock encontrado para "<strong>@groupMocksFilter</strong>".
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 resizable-table">
                                    <colgroup>
                                        <col style="width:90px;" />
                                        <col style="width:80px;" />
                                        <col />
                                        <col style="width:80px;" />
                                        <col style="width:220px;" />
                                        <col style="width:120px;" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Status</th>
                                            <th>Método</th>
                                            <th>Rota</th>
                                            <th>Código</th>
                                            <th>Descrição</th>
                                            <th>Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mock in FilteredGroupMocks)
                                        {
                                            <tr>
                                                <td><span class="badge bg-@(mock.IsActive ? "success" : "secondary")">@(mock.IsActive ? "Ativo" : "Inativo")</span></td>
                                                <td><span class="badge bg-@UiHelpers.GetMethodColor(mock.Method)">@mock.Method</span></td>
                                                <td title="@mock.Route"><code>@mock.Route</code></td>
                                                <td><span class="badge bg-@UiHelpers.GetStatusColor(mock.StatusCode)">@mock.StatusCode</span></td>
                                                <td title="@mock.Description">@mock.Description</td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => EditMock(mock.Id)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-warning" title="Remover do grupo" @onclick="() => RemoveFromGroup(mock.Id)">
                                                            <i class="bi bi-box-arrow-right"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (pendingMocks.Any())
            {
                <!-- Mocks selecionados (criação) -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Mocks Selecionados (@pendingMocks.Count)</h5>
                        <span class="badge bg-info text-dark">Serão adicionados ao salvar</span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 resizable-table">
                                <colgroup>
                                    <col style="width:90px;" />
                                    <col style="width:80px;" />
                                    <col />
                                    <col style="width:220px;" />
                                    <col style="width:80px;" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Método</th>
                                        <th>Rota</th>
                                        <th>Descrição</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mock in FilteredPendingMocks)
                                    {
                                        <tr>
                                            <td><span class="badge bg-@(mock.IsActive ? "success" : "secondary")">@(mock.IsActive ? "Ativo" : "Inativo")</span></td>
                                            <td><span class="badge bg-@UiHelpers.GetMethodColor(mock.Method)">@mock.Method</span></td>
                                            <td title="@mock.Route"><code>@mock.Route</code></td>
                                            <td title="@mock.Description">@mock.Description</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" title="Remover seleção" @onclick="() => RemoveFromPending(mock)">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Adicionar mocks ao grupo (edição e criação) -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@(IsEdit ? "Adicionar Mocks Isolados ao Grupo" : "Selecionar Mocks para o Grupo")</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Filtrar por rota..." @bind="availableFilter" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(availableFilter))
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => availableFilter = string.Empty" title="Limpar filtro">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    @if (!availableMocks.Any())
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Não há mocks isolados disponíveis para adicionar.
                        </div>
                    }
                    else if (!FilteredAvailableMocks.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-filter"></i> Nenhum mock encontrado para "<strong>@availableFilter</strong>".
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 resizable-table">
                                <colgroup>
                                    <col style="width:90px;" />
                                    <col style="width:80px;" />
                                    <col />
                                    <col style="width:220px;" />
                                    <col style="width:80px;" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Método</th>
                                        <th>Rota</th>
                                        <th>Descrição</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mock in FilteredAvailableMocks)
                                    {
                                        <tr>
                                            <td><span class="badge bg-@(mock.IsActive ? "success" : "secondary")">@(mock.IsActive ? "Ativo" : "Inativo")</span></td>
                                            <td><span class="badge bg-@UiHelpers.GetMethodColor(mock.Method)">@mock.Method</span></td>
                                            <td title="@mock.Route"><code>@mock.Route</code></td>
                                            <td title="@mock.Description">@mock.Description</td>
                                            <td>
                                                @if (IsEdit)
                                                {
                                                    <button class="btn btn-sm btn-outline-success" title="Adicionar ao grupo" @onclick="() => AddToGroup(mock.Id)">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success" title="Selecionar para o grupo" @onclick="() => AddToPending(mock)">
                                                        <i class="bi bi-plus-circle"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h6 class="mb-0">💡 Dicas</h6>
                </div>
                <div class="card-body">
                    <h6>Agrupamentos</h6>
                    <p class="small">Agrupe mocks por cenário de teste. Ex: "Token GOV", "Fluxo de Pagamento".</p>

                    <hr />

                    <h6>Regras</h6>
                    <ul class="small">
                        <li>O nome do grupo deve ser <strong>único</strong>.</li>
                        <li>Ao excluir um grupo, os mocks são desvinculados (não excluídos).</li>
                        <li>Apenas <strong>um mock ativo</strong> por rota+método em todo o sistema.</li>
                    </ul>

                    @if (!IsEdit)
                    {
                        <hr />
                        <h6>Seleção de Mocks</h6>
                        <p class="small">Clique em <i class="bi bi-plus-circle text-success"></i> para selecionar mocks. Eles serão vinculados ao grupo ao salvar.</p>
                    }

                    <hr />
                    <h6>Colunas Redimensionáveis</h6>
                    <p class="small">Arraste a borda direita dos cabeçalhos das tabelas para ajustar a largura das colunas.</p>
                </div>
            </div>
        </div>
    </div>
</div>

